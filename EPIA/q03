interface Insurable {
    double calculateInsurance();
    String getInsuranceDetails();
}

abstract class Vehicle {
    private String vehicleNumber;
    private String type;
    private double rentalRate;

    Vehicle(String vehicleNumber, String type, double rentalRate) {
        this.vehicleNumber = vehicleNumber;
        this.type = type;
        this.rentalRate = rentalRate;
    }

    abstract double calculateRentalCost(int days);

    public String getVehicleNumber() { return vehicleNumber; }
}

class Car extends Vehicle implements Insurable {
    Car(String number, double rate) { super(number, "Car", rate); }

    public double calculateRentalCost(int days) { return 50 * days; }
    public double calculateInsurance() { return 1000; }
    public String getInsuranceDetails() { return "Full coverage insurance"; }
}

class Bike extends Vehicle {
    Bike(String number, double rate) { super(number, "Bike", rate); }
    public double calculateRentalCost(int days) { return 20 * days; }
}

class Truck extends Vehicle implements Insurable {
    Truck(String number, double rate) { super(number, "Truck", rate); }
    public double calculateRentalCost(int days) { return 100 * days; }
    public double calculateInsurance() { return 2000; }
    public String getInsuranceDetails() { return "Truck insurance"; }
}
