import java.util.*;

class BMICalculator {
    // Method to compute BMI and status
    public static String[][] computeBMI(double[][] hw) {
        String[][] result = new String[hw.length][4]; // height, weight, BMI, status

        for (int i = 0; i < hw.length; i++) {
            double weight = hw[i][0];
            double heightM = hw[i][1] / 100.0; // cm to m
            double bmi = weight / (heightM * heightM);

            String status;
            if (bmi < 18.5) status = "Underweight";
            else if (bmi < 25) status = "Normal";
            else if (bmi < 30) status = "Overweight";
            else status = "Obese";

            result[i][0] = String.valueOf(hw[i][1]); // height
            result[i][1] = String.valueOf(hw[i][0]); // weight
            result[i][2] = String.format("%.2f", bmi);
            result[i][3] = status;
        }
        return result;
    }

