import java.util.*;

class StringLength {
    public static int findLength(String s) {
        int count = 0;
        try {
            while (true) {
                s.charAt(count);
                count++;
            }
        } catch (Exception e) {
            return count;
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a string: ");
        String s = sc.next();

        int customLen = findLength(s);
        int builtInLen = s.length();

        System.out.println("Length using custom method: " + customLen);
        System.out.println("Length using built-in length(): " + builtInLen);
    }
}
