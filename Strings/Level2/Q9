import java.util.*;

class RockPaperScissors {
    public static String getComputerChoice() {
        String[] choices = {"rock", "paper", "scissors"};
        return choices[(int)(Math.random() * 3)];
    }

    public static int getWinner(String user, String comp) {
        if (user.equals(comp)) return 0;
        if ((user.equals("rock") && comp.equals("scissors")) ||
            (user.equals("paper") && comp.equals("rock")) ||
            (user.equals("scissors") && comp.equals("paper")))
            return 1;
        return -1;
    }

    public static String[][] getStats(int userWins, int compWins, int total) {
        String[][] res = new String[2][3];
        res[0][0] = "User"; res[0][1] = String.valueOf(userWins);
        res[0][2] = String.valueOf((userWins * 100) / total) + "%";
        res[1][0] = "Computer"; res[1][1] = String.valueOf(compWins);
        res[1][2] = String.valueOf((compWins * 100) / total) + "%";
        return res;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("How many games? ");
        int n = sc.nextInt();
        int userWins = 0, compWins = 0;

        for (int i = 0; i < n; i++) {
            System.out.print("Enter rock/paper/scissors: ");
            String user = sc.next().toLowerCase();
            String comp = getComputerChoice();

            int result = getWinner(user, comp);
            if (result == 1) userWins++;
            else if (result == -1) compWins++;

            System.out.println("User: " + user + " | Computer: " + comp);
            if (result == 1) System.out.println("You win this round!");
            else if (result == -1) System.out.println("Computer wins this round!");
            else System.out.println("It's a tie!");
        }

        String[][] stats = getStats(userWins, compWins, n);
        System.out.println("\nFinal Results:");
        System.out.println("Player\tWins\tWin%");
        for (String[] row : stats) {
            System.out.println(row[0] + "\t" + row[1] + "\t" + row[2]);
        }
    }
}
