import java.util.Random;

public class EmployeeBonus {
    public static void main(String[] args) {
        double[][] employees = determineSalaryAndService();
        double[][] updated = calculateNewSalaryAndBonus(employees);
        displaySummary(employees, updated);
    }

    static double[][] determineSalaryAndService() {
        Random random = new Random();
        double[][] data = new double[10][2];
        for (int i = 0; i < 10; i++) {
            data[i][0] = 10000 + random.nextInt(90000);
            data[i][1] = random.nextInt(15) + 1;
        }
        return data;
    }

    static double[][] calculateNewSalaryAndBonus(double[][] data) {
        double[][] result = new double[10][3];
        for (int i = 0; i < 10; i++) {
            double salary = data[i][0];
            double service = data[i][1];
            double bonus = (service > 5) ? salary * 0.05 : salary * 0.02;
            result[i][0] = salary;
            result[i][1] = bonus;
            result[i][2] = salary + bonus;
        }
        return result;
    }

    static void displaySummary(double[][] oldData, double[][] newData) {
        double totalOld = 0, totalNew = 0, totalBonus = 0;
        System.out.printf("%-10s %-10s %-10s %-10s\n", "Employee", "OldSalary", "Bonus", "NewSalary");
        for (int i = 0; i < 10; i++) {
            System.out.printf("%-10d %-10.2f %-10.2f %-10.2f\n", i + 1, oldData[i][0], newData[i][1], newData[i][2]);
            totalOld += oldData[i][0];
            totalNew += newData[i][2];
            totalBonus += newData[i][1];
        }
        System.out.println("---------------------------------------------");
        System.out.printf("%-10s %-10.2f %-10.2f %-10.2f\n", "Total", totalOld, totalBonus, totalNew);
    }
}
