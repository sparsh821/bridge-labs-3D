import java.util.Random;
import java.util.Scanner;

public class MatrixManipulation {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter size of matrix (2 or 3): ");
        int n = sc.nextInt();

        int[][] matrix = createRandomMatrix(n, n);
        System.out.println("Original Matrix:");
        displayMatrix(matrix);

        System.out.println("Transpose:");
        displayMatrix(transpose(matrix));

        if (n == 2) {
            System.out.println("Determinant: " + determinant2x2(matrix));
            double[][] inverse = inverse2x2(matrix);
            System.out.println("Inverse:");
            displayMatrix(inverse);
        } else if (n == 3) {
            System.out.println("Determinant: " + determinant3x3(matrix));
            double[][] inverse = inverse3x3(matrix);
            System.out.println("Inverse:");
            displayMatrix(inverse);
        }

        sc.close();
    }

    static int[][] createRandomMatrix(int rows, int cols) {
        Random random = new Random();
        int[][] matrix = new int[rows][cols];
        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                matrix[i][j] = random.nextInt(10);
            }
        }
        return matrix;
    }

    static int[][] transpose(int[][] matrix) {
        int n = matrix.length;
        int[][] result = new int[n][n];
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                result[j][i] = matrix[i][j];
            }
        }
        return result;
    }

    static int determinant2x2(int[][] matrix) {
        return matrix[0][0] * matrix[1][1] - matrix[0][1] * matrix[1][0];
    }

    static int determinant3x3(int[][] matrix) {
        int a = matrix[0][0], b = matrix[0][1], c = matrix[0][2];
        int d = matrix[1][0], e = matrix[1][1], f = matrix[1][2];
        int g = matrix[2][0], h = matrix[2][1], i = matrix[2][2];
        return a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g);
    }

    static double[][] inverse2x2(int[][] matrix) {
        int det = determinant2x2(matrix);
        double[][] inv = new double[2][2];
        if (det == 0) return null;
        inv[0][0] = matrix[1][1] / (double) det;
        inv[0][1] = -matrix[0][1] / (double) det;
        inv[1][0] = -matrix[1][0] / (double) det;
        inv[1][1] = matrix[0][0] / (double) det;
        return inv;
    }

    static double[][] inverse3x3(int[][] matrix) {
        int det = determinant3x3(matrix);
        double[][] inv = new double[3][3];
        if (det == 0) return null;
        for (int row = 0; row < 3; row++) {
            for (int col = 0; col < 3; col++) {
                inv[col][row] = cofactor(matrix, row, col) / (double) det;
            }
        }
        return inv;
    }

    static int cofactor(int[][] matrix, int row, int col) {
        int[][] sub = new int[2][2];
        int subi = 0;
        for (int i = 0; i < 3; i++) {
            if (i == row) continue;
            int subj = 0;
            for (int j = 0; j < 3; j++) {
                if (j == col) continue;
                sub[subi][subj] = matrix[i][j];
                subj++;
            }
            subi++;
        }
        int det = sub[0][0] * sub[1][1] - sub[0][1] * sub[1][0];
        if ((row + col) % 2 != 0) det = -det;
        return det;
    }

    static void displayMatrix(int[][] matrix) {
        for (int[] row : matrix) {
            for (int val : row) {
                System.out.printf("%4d", val);
            }
            System.out.println();
        }
    }

    static void displayMatrix(double[][] matrix) {
        if (matrix == null) {
            System.out.println("Inverse does not exist (determinant is 0).");
            return;
        }
        for (double[] row : matrix) {
            for (double val : row) {
                System.out.printf("%8.3f", val);
            }
            System.out.println();
        }
    }
}
